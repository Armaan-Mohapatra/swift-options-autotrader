# ==============================================================================
# Swift Options AutoTrader - Configuration Template
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - Never commit real credentials, tokens, account numbers, or .session files.
# - Keep your production .env outside the git checkout or strictly in your .gitignore.
#
# ==============================================================================
# 1. EXECUTION MODE SELECTION
# ==============================================================================
# Safe PAPER mode (default). Machine-wide PAPER_*/LIVE_* variables set for other
# software must never be inherited: the Windows launchers set these explicitly.
PAPER_ONLY=true
LIVE_ENABLED=false
ALLOW_BROKER_WRITES=false
BROKER_BACKEND=paper
TELEGRAM_ENABLED=false

# LIVE mode requires an exact local acceptance receipt AND all of the following; any
# missing or contradictory value is a startup ERROR, never a silent fall-back:
#   PAPER_ONLY=false, LIVE_ENABLED=true, ALLOW_BROKER_WRITES=true,
#   BROKER_BACKEND=robinhood_mcp, TELEGRAM_ENABLED=true,
#   ROBINHOOD_MCP_ACCOUNT=<dedicated agentic account number, never committed>,
#   LIVE_JOURNAL_PATH=<absolute path of the separate durable live journal>
# ROBINHOOD_MCP_ACCOUNT=
# LIVE_JOURNAL_PATH=

# ==============================================================================
# 2. DATABASE & LOGGING
# ==============================================================================
DB_PATH=./data/swift_autotrader.sqlite3
LOG_LEVEL=INFO

# ==============================================================================
# 3. POSITION SIZING & RISK
# ==============================================================================
# Approved HARD maxima live in src/swift_autotrader/risk_limits.py:
#   1 contract per alert, $999 premium per entry, $750 New York-day net loss.
# Anything higher is rejected at startup. MAX_PREMIUM_PER_SIGNAL_USD=0 denies every buy.
MAX_CONTRACTS_PER_SIGNAL=1
MAX_PREMIUM_PER_SIGNAL_USD=999
ENTRY_TIMEOUT_SECONDS=3600
# Realized-plus-unrealized daily net-loss latch (max 750). Unknown P&L blocks new entries.
MAX_DAILY_LOSS_USD=750
PAPER_MAX_DAILY_NET_LOSS_USD=750
# There is NO trade-count or aggregate-exposure cap: leave these blank and only
# available buying power limits how many trades can be open.
MAX_TOTAL_EXPOSURE_USD=
PAPER_MAX_TOTAL_EXPOSURE_USD=
PAPER_MAX_OPEN_SIGNALS=
# Entries always use the exact alert limit. A 10% quote deviation is a built-in
# REJECTION guard, never a configurable allowance: SLIPPAGE_TOLERANCE_PCT must stay
# unset or 0 (any positive value is refused at startup).

# ==============================================================================
# 4. TELEGRAM SOURCE (configure ONLY in an authorized local Windows environment)
# ==============================================================================
TELEGRAM_QUEUE_CAPACITY=512
TELEGRAM_MAX_LIVE_AGE_SECONDS=120
TELEGRAM_RECONNECT_ATTEMPTS=5
# SWIFT_TELEGRAM_CHANNEL_ID=<signed -100... peer ID confirmed from your subscription>
# TELEGRAM_API_ID=<locally obtained Telegram user developer API ID>
# TELEGRAM_API_HASH=<local 32 character API hash>
# TELEGRAM_SESSION_PATH=<absolute protected out-of-repo existing .session path>

# ==============================================================================
# 5. MOBILE KILL SWITCH (optional; pauses/stops entries, never places orders)
# ==============================================================================
KILL_SWITCH_ENABLED=false
# KILL_SWITCH_TELEGRAM_BOT_TOKEN=<local bot token; never committed>
# KILL_SWITCH_TELEGRAM_CHAT_ID=<your private chat ID>
