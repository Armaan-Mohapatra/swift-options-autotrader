# PLACEHOLDERS ONLY. Never paste tokens, session strings, paid Telegram messages or account IDs into GitHub.
# Phase 0 refuses any configuration that could permit real broker writes.
PAPER_ONLY=true
LIVE_ENABLED=false
ALLOW_BROKER_WRITES=false
BROKER_BACKEND=paper
TELEGRAM_ENABLED=false
# Local persistence only. Do not use a production path belonging to another app.
DB_PATH=./data/swift_autotrader.sqlite3
MAX_CONTRACTS_PER_SIGNAL=1
MAX_PREMIUM_PER_SIGNAL_USD=0
ENTRY_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO
# Future local authorization only (not implemented in Phase 0):
# SWIFT_TELEGRAM_CHANNEL_ID=<set locally after verification>
# TELEGRAM_API_ID=<set locally>
# TELEGRAM_API_HASH=<set locally>
# ROBINHOOD_MCP_URL=<official URL, validate in Phase 4>
