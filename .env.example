# PLACEHOLDERS ONLY. Never commit Telegram, Robinhood, or private Swift values.
PAPER_ONLY=true
LIVE_ENABLED=false
ALLOW_BROKER_WRITES=false
BROKER_BACKEND=paper
TELEGRAM_ENABLED=false
DB_PATH=./data/swift_autotrader.sqlite3
MAX_CONTRACTS_PER_SIGNAL=1
MAX_PREMIUM_PER_SIGNAL_USD=999
ENTRY_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO
TELEGRAM_QUEUE_CAPACITY=512
TELEGRAM_MAX_LIVE_AGE_SECONDS=120
TELEGRAM_RECONNECT_ATTEMPTS=5
# Configure the following ONLY in an authorized local Windows environment:
# SWIFT_TELEGRAM_CHANNEL_ID=<signed -100... peer ID confirmed from your subscription>
# TELEGRAM_API_ID=<locally obtained Telegram user developer API ID>
# TELEGRAM_API_HASH=<local 32 character API hash>
# TELEGRAM_SESSION_PATH=<absolute protected out-of-repo existing .session path>
# ROBINHOOD_MCP_URL=<future only, no real broker connections in Phase 1>

# Phase 3 synthetic-paper risk controls. Values are the approved HARD MAXIMUMS
# (src/swift_autotrader/risk_limits.py); anything higher is rejected at startup.
# A value of 0 for a dollar ceiling still denies every new buy.
PAPER_MAX_TOTAL_EXPOSURE_USD=10000
PAPER_MAX_DAILY_NET_LOSS_USD=750
PAPER_MAX_OPEN_SIGNALS=1
PAPER_ENTRY_MAX_AGE_SECONDS=120
PAPER_EXIT_QUOTE_MAX_AGE_SECONDS=30

# Phase 4 default: interactive Robinhood OAuth disabled; keep secrets outside repo.
ROBINHOOD_MCP_INTERACTIVE=false
