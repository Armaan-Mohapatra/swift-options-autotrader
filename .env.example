# ==============================================================================
# Swift Options AutoTrader - Configuration Template
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - Never commit real credentials, tokens, account numbers, or .session files.
# - Keep your production .env outside the git checkout or strictly in your .gitignore.
#
# ==============================================================================
# 1. EXECUTION MODE SELECTION
# ==============================================================================
# To run in safe PAPER mode (default):
PAPER_ONLY=true
LIVE_ENABLED=false
ALLOW_BROKER_WRITES=false
BROKER_BACKEND=paper

# To run in UNATTENDED LIVE mode (requires verified Robinhood & Telegram setup):
# PAPER_ONLY=false
# LIVE_ENABLED=true
# ALLOW_BROKER_WRITES=true
# BROKER_BACKEND=robinhood_mcp

# ==============================================================================
# 2. DATABASE & LOGGING
# ==============================================================================
DB_PATH=./data/swift_autotrader.sqlite3
LOG_LEVEL=INFO

# ==============================================================================
# 3. POSITION SIZING & RISK CEILINGS
# ==============================================================================
MAX_CONTRACTS_PER_SIGNAL=1
MAX_PREMIUM_PER_SIGNAL_USD=500
ENTRY_TIMEOUT_SECONDS=3600

# Live Risk Controls (active only when LIVE_ENABLED=true)
# MAX_DAILY_LOSS_USD: Cumulative realized loss ceiling in USD per trading day before emergency halt (positive, max 10000)
MAX_DAILY_LOSS_USD=750
# MAX_CONCURRENT_POSITIONS: Maximum simultaneous open option positions allowed (integer 1-10)
MAX_CONCURRENT_POSITIONS=3
# SLIPPAGE_TOLERANCE_PCT: Maximum acceptable percentage slippage above alert entry limit price (0-25 percent)
SLIPPAGE_TOLERANCE_PCT=10

# Paper-only Risk Controls
PAPER_MAX_TOTAL_EXPOSURE_USD=1000
PAPER_MAX_OPEN_SIGNALS=3
PAPER_ENTRY_MAX_AGE_SECONDS=120
PAPER_EXIT_QUOTE_MAX_AGE_SECONDS=30

# ==============================================================================
# 4. TELEGRAM INGESTION (SwiftTrades Channel)
# ==============================================================================
TELEGRAM_ENABLED=false
TELEGRAM_QUEUE_CAPACITY=512
TELEGRAM_MAX_LIVE_AGE_SECONDS=120
TELEGRAM_RECONNECT_ATTEMPTS=5

# Authorized Local Telegram Configuration:
# SWIFT_TELEGRAM_CHANNEL_ID=-1001234567890
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# TELEGRAM_SESSION_PATH=/Users/armaan/.config/swift_autotrader/telegram.session

# ==============================================================================
# 5. ROBINHOOD AGENTIC MCP INTEGRATION
# ==============================================================================
ROBINHOOD_MCP_INTERACTIVE=false
# Dedicated Agentic Account Number from Robinhood (required for live):
# ROBINHOOD_MCP_ACCOUNT=123456789

# ==============================================================================
# 6. MOBILE EMERGENCY KILL-SWITCH (Telegram Bot)
# ==============================================================================
KILL_SWITCH_ENABLED=false
# Optional mobile bot; not required for MVP. Local stop and broker controls remain separate.
# KILL_SWITCH_TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# KILL_SWITCH_TELEGRAM_CHAT_ID=123456789
